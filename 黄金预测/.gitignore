# ---- 采集产物：每日变动、体积大，不入库 ----
# gold.db 约 7MB、features.csv 约 2MB、market.csv 约 900KB，
# 都是脚本可重新生成的中间数据，提交进来只会让仓库膨胀且每天产生无意义 diff。
data/
*.db

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- macOS ----
.DS_Store
._*

# ---- 编辑器 ----
.vscode/
.idea/
.Rhistory

